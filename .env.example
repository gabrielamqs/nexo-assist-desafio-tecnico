# Chave da API do Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Banco SQLite. Em produção, apontar para o caminho absoluto do volume persistente.
DATABASE_URL=file:./data/nexo-assist.db

# Segredo para assinar o cookie de sessão (ex.: openssl rand -base64 32)
SESSION_SECRET=

# Probabilidade (0 a 1) de o sistema legado de chamados simular indisponibilidade
TICKET_SERVICE_FAILURE_RATE=0.1
