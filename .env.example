# Chave da API do Google Gemini: https://aistudio.google.com/app/apikey
# Obrigatória em produção. Só é lida no servidor — nunca prefixar com NEXT_PUBLIC_.
GEMINI_API_KEY=

# Modelo do Gemini usado pelo agent
GEMINI_MODEL=gemini-3.5-flash-lite

# Banco libSQL/SQLite. Em desenvolvimento é um arquivo local, criado e
# semeado sozinho no primeiro boot. Em produção (Vercel) aponta para o Turso:
# libsql://<nome-do-banco>-<organizacao>.turso.io
DATABASE_URL=file:./data/nexo-assist.db

# Token de acesso ao banco remoto, emitido pelo Turso.
# Obrigatório sempre que DATABASE_URL não for um arquivo local.
DATABASE_AUTH_TOKEN=

# Segredo para assinar o cookie de sessão (ex.: openssl rand -base64 32)
# Obrigatório em produção, mínimo de 32 caracteres.
SESSION_SECRET=

# Endereço do serviço de chamados (MCP) que o agent consome.
# Se ficar vazio, é derivado sozinho: na Vercel, de VERCEL_URL
# (https://$VERCEL_URL/api/mcp); fora dela, de PORT (http://localhost:$PORT/api/mcp).
# Só preencha para apontar para outra instância, ou se rodar o dev em outra porta.
MCP_SERVER_URL=

# Porta em que o app escuta. Em produção a plataforma costuma definir sozinha,
# e na Vercel ela não é usada (serverless, sem porta própria).
PORT=3000

# Probabilidade (0 a 1) de o sistema legado de chamados simular indisponibilidade.
# É proposital: o desafio pede tratamento de falha. Baixar para 0 em uma demonstração ao vivo.
TICKET_SERVICE_FAILURE_RATE=0.1
